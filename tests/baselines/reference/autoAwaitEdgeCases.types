//// [tests/cases/syn/autoAwaitEdgeCases.syn] ////

=== autoAwaitEdgeCases.syn ===
{
    type MyPromise = Promise<number>
>MyPromise : Promise<number>
>          : ^^^^^^^^^^^^^^^

    function aliased(): MyPromise {
>aliased : () => Promise<number>
>        : ^^^^^^^^^^^^^^^^^^^^^

        return Promise.resolve(1)
>Promise.resolve(1) : Promise<number>
>                   : ^^^^^^^^^^^^^^^
>Promise.resolve : { (): Promise<void>; <T>(value: T): Promise<Awaited<T>>; <T>(value: T | PromiseLike<T>): Promise<Awaited<T>>; }
>                : ^^^^^^             ^^^ ^^     ^^ ^^^                   ^^^ ^^     ^^                  ^^^                   ^^^
>Promise : PromiseConstructor
>        : ^^^^^^^^^^^^^^^^^^
>resolve : { (): Promise<void>; <T>(value: T): Promise<Awaited<T>>; <T>(value: T | PromiseLike<T>): Promise<Awaited<T>>; }
>        : ^^^^^^             ^^^ ^^     ^^ ^^^                   ^^^ ^^     ^^                  ^^^                   ^^^
>1 : 1
>  : ^
    }

    async function f1() {
>f1 : () => Promise<void>
>   : ^^^^^^^^^^^^^^^^^^^

        const n = aliased() // number
>n : Promise<number>
>  : ^^^^^^^^^^^^^^^
>aliased() : Promise<number>
>          : ^^^^^^^^^^^^^^^
>aliased : () => Promise<number>
>        : ^^^^^^^^^^^^^^^^^^^^^
    }

    const m1 = new Map<number, MyPromise>()
>m1 : Map<number, Promise<number>>
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>new Map<number, MyPromise>() : Map<number, Promise<number>>
>                             : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>Map : MapConstructor
>    : ^^^^^^^^^^^^^^

    const m2 = new Map<number, Promise<number>>()
>m2 : Map<number, Promise<number>>
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>new Map<number, Promise<number>>() : Map<number, Promise<number>>
>                                   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>Map : MapConstructor
>    : ^^^^^^^^^^^^^^

    async function f2() {
>f2 : () => Promise<void>
>   : ^^^^^^^^^^^^^^^^^^^

        const n1 = m1.get(0) // Promise<number> | undefined
>n1 : Promise<number> | undefined
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m1.get(0) : Promise<number> | undefined
>          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m1.get : (key: number) => Promise<number> | undefined
>       : ^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m1 : Map<number, Promise<number>>
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>get : (key: number) => Promise<number> | undefined
>    : ^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>0 : 0
>  : ^

        const n2 = m2.get(0) // Promise<number> | undefined
>n2 : Promise<number> | undefined
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m2.get(0) : Promise<number> | undefined
>          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m2.get : (key: number) => Promise<number> | undefined
>       : ^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m2 : Map<number, Promise<number>>
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>get : (key: number) => Promise<number> | undefined
>    : ^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>0 : 0
>  : ^
    }

    function f3(): Promise<number> | undefined {
>f3 : () => Promise<number> | undefined
>   : ^^^^^^                           

        return m1.get(0)
>m1.get(0) : Promise<number> | undefined
>          : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m1.get : (key: number) => Promise<number> | undefined
>       : ^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>m1 : Map<number, Promise<number>>
>   : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>get : (key: number) => Promise<number> | undefined
>    : ^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>0 : 0
>  : ^
    }

    async function f4() {
>f4 : () => Promise<void>
>   : ^^^^^^^^^^^^^^^^^^^

        const n = f3() // Promise<number> | undefined
>n : Promise<number> | undefined
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f3() : Promise<number> | undefined
>     : ^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f3 : () => Promise<number> | undefined
>   : ^^^^^^                           
    }

    class Box<T> {
>Box : Box<T>
>    : ^^^^^^

        get(): T {
>get : () => T
>    : ^^^^^^ 

            throw ""
>"" : ""
>   : ^^
        }
    }

    const b: Box<Promise<number>> = new Box()
>b : Box<Promise<number>>
>  : ^^^^^^^^^^^^^^^^^^^^
>new Box() : Box<Promise<number>>
>          : ^^^^^^^^^^^^^^^^^^^^
>Box : typeof Box
>    : ^^^^^^^^^^

    async function f5() {
>f5 : () => Promise<void>
>   : ^^^^^^^^^^^^^^^^^^^

        const n = b.get() // Promise<number>
>n : Promise<number>
>  : ^^^^^^^^^^^^^^^
>b.get() : Promise<number>
>        : ^^^^^^^^^^^^^^^
>b.get : () => Promise<number>
>      : ^^^^^^^^^^^^^^^^^^^^^
>b : Box<Promise<number>>
>  : ^^^^^^^^^^^^^^^^^^^^
>get : () => Promise<number>
>    : ^^^^^^^^^^^^^^^^^^^^^

        const n2 = b.get().then(x => x + 1) // number
>n2 : number
>   : ^^^^^^
>b.get().then(x => x + 1) : number
>                         : ^^^^^^
>b.get().then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>             : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>b.get() : Promise<number>
>        : ^^^^^^^^^^^^^^^
>b.get : () => Promise<number>
>      : ^^^^^^^^^^^^^^^^^^^^^
>b : Box<Promise<number>>
>  : ^^^^^^^^^^^^^^^^^^^^
>get : () => Promise<number>
>    : ^^^^^^^^^^^^^^^^^^^^^
>then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>     : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x => x + 1 : (x: number) => number
>           : ^ ^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x + 1 : number
>      : ^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
    }

    // special case: promise chains
    // the end result is auto-awaited, not the initial call
    async function foo() { return 2 }
>foo : () => Promise<number>
>    : ^^^^^^^^^^^^^^^^^^^^^
>2 : 2
>  : ^

    async function f6() {
>f6 : () => Promise<void>
>   : ^^^^^^^^^^^^^^^^^^^

        // number | void
        const n = foo().then(x => x + 1).catch(e => {})
>n : number | void
>  : ^^^^^^^^^^^^^
>foo().then(x => x + 1).catch(e => {}) : number | void
>                                      : ^^^^^^^^^^^^^
>foo().then(x => x + 1).catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<number | TResult>
>                             : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo().then(x => x + 1) : Promise<number>
>                       : ^^^^^^^^^^^^^^^
>foo().then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>           : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo() : Promise<number>
>      : ^^^^^^^^^^^^^^^
>foo : () => Promise<number>
>    : ^^^^^^^^^^^^^^^^^^^^^
>then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>     : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x => x + 1 : (x: number) => number
>           : ^ ^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x + 1 : number
>      : ^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<number | TResult>
>      : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>e => {} : (e: any) => void
>        : ^ ^^^^^^^^^^^^^^
>e : any

        // Promise<number | void>
        const n2 = foo().then(x => x + 1).catch(e => {}) as async
>n2 : Promise<number | void>
>   : ^^^^^^^^^^^^^^^^^^^^^^
>foo().then(x => x + 1).catch(e => {}) as async : Promise<number | void>
>                                               : ^^^^^^^^^^^^^^^^^^^^^^
>foo().then(x => x + 1).catch(e => {}) : Promise<number | void>
>                                      : ^^^^^^^^^^^^^^^^^^^^^^
>foo().then(x => x + 1).catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<number | TResult>
>                             : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo().then(x => x + 1) : Promise<number>
>                       : ^^^^^^^^^^^^^^^
>foo().then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>           : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo() : Promise<number>
>      : ^^^^^^^^^^^^^^^
>foo : () => Promise<number>
>    : ^^^^^^^^^^^^^^^^^^^^^
>then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>     : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x => x + 1 : (x: number) => number
>           : ^ ^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x + 1 : number
>      : ^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<number | TResult>
>      : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>e => {} : (e: any) => void
>        : ^ ^^^^^^^^^^^^^^
>e : any

        const n3 = foo().then(x => x + 1).toFixed(1) // string
>n3 : string
>   : ^^^^^^
>foo().then(x => x + 1).toFixed(1) : string
>                                  : ^^^^^^
>foo().then(x => x + 1).toFixed : (fractionDigits?: number) => string
>                               : ^              ^^^      ^^^^^      
>foo().then(x => x + 1) : number
>                       : ^^^^^^
>foo().then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>           : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>foo() : Promise<number>
>      : ^^^^^^^^^^^^^^^
>foo : () => Promise<number>
>    : ^^^^^^^^^^^^^^^^^^^^^
>then : <TResult1 = number, TResult2 = never>(onfulfilled?: ((value: number) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>     : ^        ^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>x => x + 1 : (x: number) => number
>           : ^ ^^^^^^^^^^^^^^^^^^^
>x : number
>  : ^^^^^^
>x + 1 : number
>      : ^^^^^^
>x : number
>  : ^^^^^^
>1 : 1
>  : ^
>toFixed : (fractionDigits?: number) => string
>        : ^              ^^^      ^^^^^      
>1 : 1
>  : ^
    }

    class Catchable {
>Catchable : Catchable
>          : ^^^^^^^^^

        catch() { return 0 }
>catch : () => number
>      : ^^^^^^^^^^^^
>0 : 0
>  : ^

        finally() { return 0 }
>finally : () => number
>        : ^^^^^^^^^^^^
>0 : 0
>  : ^
    }

    async function f7() {
>f7 : () => Promise<void>
>   : ^^^^^^^^^^^^^^^^^^^

        const f = async () => new Catchable()
>f : () => Promise<Catchable>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>async () => new Catchable() : () => Promise<Catchable>
>                            : ^^^^^^^^^^^^^^^^^^^^^^^^
>new Catchable() : Catchable
>                : ^^^^^^^^^
>Catchable : typeof Catchable
>          : ^^^^^^^^^^^^^^^^

        f().catch() // number
>f().catch() : Catchable
>            : ^^^^^^^^^
>f().catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<Catchable | TResult>
>          : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f() : Promise<Catchable>
>    : ^^^^^^^^^^^^^^^^^^
>f : () => Promise<Catchable>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<Catchable | TResult>
>      : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

        f().finally() // number
>f().finally() : Catchable
>              : ^^^^^^^^^
>f().finally : (onfinally?: (() => void) | null | undefined) => Promise<Catchable>
>            : ^         ^^^^^^^^^^    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f() : Promise<Catchable>
>    : ^^^^^^^^^^^^^^^^^^
>f : () => Promise<Catchable>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>finally : (onfinally?: (() => void) | null | undefined) => Promise<Catchable>
>        : ^         ^^^^^^^^^^    ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

        // error, emits as `(await f().catch()).then()` because we must materialize after `.catch`
        f().catch().then()
>f().catch().then() : Catchable
>                   : ^^^^^^^^^
>f().catch().then : <TResult1 = Catchable, TResult2 = never>(onfulfilled?: ((value: Catchable) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>                 : ^        ^^^^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f().catch() : Promise<Catchable>
>            : ^^^^^^^^^^^^^^^^^^
>f().catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<Catchable | TResult>
>          : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>f() : Promise<Catchable>
>    : ^^^^^^^^^^^^^^^^^^
>f : () => Promise<Catchable>
>  : ^^^^^^^^^^^^^^^^^^^^^^^^
>catch : <TResult = never>(onrejected?: ((reason: any) => TResult | PromiseLike<TResult>) | null | undefined) => Promise<Catchable | TResult>
>      : ^       ^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>then : <TResult1 = Catchable, TResult2 = never>(onfulfilled?: ((value: Catchable) => TResult1 | PromiseLike<TResult1>) | null | undefined, onrejected?: ((reason: any) => TResult2 | PromiseLike<TResult2>) | null | undefined) => Promise<TResult1 | TResult2>
>     : ^        ^^^^^^^^^^^^^^        ^^^^^^^^^^           ^^^^^     ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^          ^^^^^      ^^   ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
    }
}

