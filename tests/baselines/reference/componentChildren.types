>  : ^
>items[0] : T
>         : ^
>items : T[]
>      : ^^^
>0 : 0
>  : ^

        </div>
>div : any
>    : ^^^

    </>
    const items = [
>items : { id: number; first: string; last: string; }[]
>      : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>[        { id: 1, first: '1', last: '2' },        { id: 2, first: '3', last: '4' }    ] : { id: number; first: string; last: string; }[]
>                                                                                        : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

        { id: 1, first: '1', last: '2' },
>{ id: 1, first: '1', last: '2' } : { id: number; first: string; last: string; }
>                                 : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>id : number
>   : ^^^^^^
>1 : 1
>  : ^
>first : string
>      : ^^^^^^
>'1' : "1"
>    : ^^^
>last : string
>     : ^^^^^^
>'2' : "2"
>    : ^^^

        { id: 2, first: '3', last: '4' }
>{ id: 2, first: '3', last: '4' } : { id: number; first: string; last: string; }
