    <#component List<T>(items: T[], children: [(x: T) => ChildNode], key?: (x: T) => string | number)>
>List : any
>     : ^^^
>items : T[]
>      : ^^^
>children : [(x: T) => ChildNode]
>         : ^^ ^^ ^^^^^         ^
