//// [tests/cases/syn/elementNames.syn] ////

=== elementNames.syn ===
// element names
{
    // b can be seen within the tree, but not outside
    const a = <div @ a>
>a : HTMLDivElement & Updatable
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
><div @ a>        <div @ b></div>        <#run>            console.log(a, b)        </>    </div> : HTMLDivElement & Updatable
>                                                                                                 : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>div : any
>    : ^^^
>a : HTMLDivElement & Updatable
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^

        <div @ b></div>
><div @ b></div> : HTMLDivElement & Updatable
>                : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>div : any
>    : ^^^
>b : HTMLDivElement & Updatable
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>div : any
>    : ^^^

        <#run>
            console.log(a, b)
>console.log(a, b) : void
>                  : ^^^^
>console.log : (...data: any[]) => void
>            : ^^^^    ^^     ^^^^^    
>console : Console
>        : ^^^^^^^
>log : (...data: any[]) => void
>    : ^^^^    ^^     ^^^^^    
>a : HTMLDivElement & Updatable
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>b : HTMLDivElement & Updatable
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^

        </>
    </div>
>div : any
>    : ^^^

    console.log(a, b);
>console.log(a, b) : void
>                  : ^^^^
>console.log : (...data: any[]) => void
>            : ^^^^    ^^     ^^^^^    
>console : Console
>        : ^^^^^^^
>log : (...data: any[]) => void
>    : ^^^^    ^^     ^^^^^    
>a : HTMLDivElement & Updatable
>  : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>b : any
>  : ^^^

    <div @ c id="aaa" />;
><div @ c id="aaa" /> : HTMLDivElement & Updatable
>                     : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>div : any
>    : ^^^
>c : any
>  : ^^^
>id : string
>   : ^^^^^^
}

{
    <div @ d />;
><div @ d /> : HTMLDivElement & Updatable
>            : ^^^^^^^^^^^^^^^^^^^^^^^^^^
>div : any
>    : ^^^
>d : any
>  : ^^^

    console.log(d) // should error
>console.log(d) : void
>               : ^^^^
>console.log : (...data: any[]) => void
>            : ^^^^    ^^     ^^^^^    
>console : Console
>        : ^^^^^^^
>log : (...data: any[]) => void
>    : ^^^^    ^^     ^^^^^    
>d : any
>  : ^^^
}

