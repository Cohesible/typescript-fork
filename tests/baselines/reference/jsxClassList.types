    // class attribute cannot be used with class list
    <div .a class="b" />;
><div .a class="b" /> : HTMLDivElement
>                     : ^^^^^^^^^^^^^^
>div : any
>    : ^^^
>a : any
>  : ^^^
>class : string
>      : ^^^^^^

    <div .a {...{ class: 'b' }} />;
><div .a {...{ class: 'b' }} /> : HTMLDivElement
>                               : ^^^^^^^^^^^^^^
>div : any
>    : ^^^
>a : any
>  : ^^^
>{ class: 'b' } : { class: string; }
>               : ^^^^^^^^^^^^^^^^^^
>class : string
>      : ^^^^^^
>'b' : "b"
>    : ^^^

    // ok
    <div class="b" />;
><div class="b" /> : HTMLDivElement
>                  : ^^^^^^^^^^^^^^
>div : any
>    : ^^^
>class : string
>      : ^^^^^^

    // ok
    const cond2 = false as boolean
>cond2 : boolean
>      : ^^^^^^^
>false as boolean : boolean
>                 : ^^^^^^^
>false : false
>      : ^^^^^

    const cond3 = false as boolean;
>cond3 : boolean
>      : ^^^^^^^
>false as boolean : boolean
>                 : ^^^^^^^
>false : false
>      : ^^^^^

    <div (.a={cond}, .a.b={cond2}, .a={cond3})></div>;
><div (.a={cond}, .a.b={cond2}, .a={cond3})></div> : HTMLDivElement
