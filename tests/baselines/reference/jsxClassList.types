//// [tests/cases/syn/jsxClassList.syn] ////

=== jsxClassList.syn ===
{
    const cond = true;
>cond : true
>     : ^^^^
>true : true
>     : ^^^^

    <div .foo/>;
><div .foo/> : HTMLDivElement
>            : ^^^^^^^^^^^^^^
>div : any
>    : ^^^
>foo : any
>    : ^^^

    <div .foo></div>;
><div .foo></div> : HTMLDivElement
>                 : ^^^^^^^^^^^^^^
>div : any
>    : ^^^
>foo : any
>    : ^^^
>div : any
>    : ^^^

    // class attributes should not conflict with normal attributes
    <input .min min=500></input>;
><input .min min=500></input> : HTMLInputElement
>                             : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^
>min : any
>    : ^^^
>min : number
>    : ^^^^^^
>input : any
>      : ^^^

    <input (.min.min2)></input>;
><input (.min.min2)></input> : HTMLInputElement
>                            : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^
>min : any
>    : ^^^
>min2 : any
>     : ^^^
>input : any
>      : ^^^

    <input (.min.min2={cond})></input>;
><input (.min.min2={cond})></input> : HTMLInputElement
>                                   : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^
>min : any
>    : ^^^
>min2 : any
>     : ^^^
>cond : true
>     : ^^^^
>input : any
>      : ^^^

    <input (.min.min2={cond}, .bar)></input>;
><input (.min.min2={cond}, .bar)></input> : HTMLInputElement
>                                         : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^
>min : any
>    : ^^^
>min2 : any
>     : ^^^
>cond : true
>     : ^^^^
>bar : any
>    : ^^^
>input : any
>      : ^^^

    <input .min.min2={cond}></input>;
><input .min.min2={cond}></input> : HTMLInputElement
>                                 : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^
>min : any
>    : ^^^
>min2 : any
>     : ^^^
>cond : true
>     : ^^^^
>input : any
>      : ^^^

    <input .min.min2={cond} @ i></input>;
><input .min.min2={cond} @ i></input> : HTMLInputElement
>                                     : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^
>min : any
>    : ^^^
>min2 : any
>     : ^^^
>cond : true
>     : ^^^^
>i : HTMLInputElement
>  : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^

    <input (.m) @ i2></input>;
><input (.m) @ i2></input> : HTMLInputElement
>                          : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^
>m : any
>  : ^^^
>i2 : HTMLInputElement
>   : ^^^^^^^^^^^^^^^^
>input : any
>      : ^^^

    // errors emitted during parse
    <div id="foo" .a.a></div>;
><div id="foo" .a.a></div> : HTMLDivElement
