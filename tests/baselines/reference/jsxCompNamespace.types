=== jsxCompNamespace.syn ===
<#component Foo(children) {
>Foo : error
>children : JSX.Children
>         : ^^^^^^^^^^^^

    public { Bar }
>Bar : () => Bar
>    : ^^^^^^^^^

}>
    <div>{...children}</div>
><div>{...children}</div> : HTMLDivElement
>                         : ^^^^^^^^^^^^^^
>div : any
>    : ^^^
