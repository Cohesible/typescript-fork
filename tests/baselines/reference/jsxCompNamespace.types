        <div></div>
><div></div> : HTMLDivElement
>            : ^^^^^^^^^^^^^^
>div : any
>    : ^^^
>div : any
>    : ^^^

    </>
</>

const x = <Foo></Foo>
>x : Foo
>  : ^^^
><Foo></Foo> : Foo
>            : ^^^
>Foo : (attributes: {}, children: JSX.Children) => Foo
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^
>Foo : (attributes: {}, children: JSX.Children) => Foo
>    : ^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^^

const arr: Foo.Bar[] = []
>arr : Bar[]
>    : ^^^^^
>Foo : any
>    : ^^^
>[] : never[]
>   : ^^^^^^^

arr.push(<x.Bar/>)
>arr.push(<x.Bar/>) : number
>                   : ^^^^^^
>arr.push : (...items: Bar[]) => number
