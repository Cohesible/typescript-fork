{
    let filterState: 'all' | 'completed' | 'active' = 'all';
>filterState : Symbol(filterState, Decl(jsxIf.syn, 38, 7))

    <div>
>div : Symbol(JSX.IntrinsicElements.div, Decl(lib.jsx.d.ts, --, --))

        <#run>
            let c
>c : Symbol(c, Decl(jsxIf.syn, 41, 15))

            switch (filterState) {
>filterState : Symbol(filterState, Decl(jsxIf.syn, 38, 7))

                case 'all': c = 1;
>c : Symbol(c, Decl(jsxIf.syn, 41, 15))

                case 'completed': c = 2;
>c : Symbol(c, Decl(jsxIf.syn, 41, 15))

                case 'active': c = 3;
>c : Symbol(c, Decl(jsxIf.syn, 41, 15))
            }
        </>
    </div>
