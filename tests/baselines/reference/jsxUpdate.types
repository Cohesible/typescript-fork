{
    let c = 0
>c : number
>  : ^^^^^^
>0 : 0
>  : ^

    ;<div @ root>
><div @ root>        {c}        <#run>            update root {                c += 1            }            if (c < 10) {                // ok                update root {                    c += 1                }            }        </>        <div @ d>            <#run>                update root {                    c += 1                }            </>        </div>    </div> : HTMLDivElement
