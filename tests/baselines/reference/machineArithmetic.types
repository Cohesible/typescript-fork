//// [tests/cases/syn/machineArithmetic.syn] ////

=== machineArithmetic.syn ===
declare const a: u32
>a : u32
>  : ^^^

declare const b: u32
>b : u32
>  : ^^^

declare const c: u64
>c : u64
>  : ^^^

declare const lit: 200
>lit : 200
>    : ^^^

declare const lit2: 200 | 256
>lit2 : 200 | 256
>     : ^^^^^^^^^

// default: widens to plain number
const defaultResult: number = a + b
>defaultResult : number
>              : ^^^^^^
>a + b : number
>      : ^^^^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^

// assignability: widening is fine
const w: u64 = a
>w : u64
>  : ^^^
>a : u32
>  : ^^^

const w2: u64 = c
>w2 : u64
>   : ^^^
>c : u64
>  : ^^^

// assignability: narrowing/cross-kind should be flagged
const bad1: u32 = c
>bad1 : u32
>     : ^^^
>c : u64
>  : ^^^

const bad2: i32 = a
>bad2 : i32
>     : ^^^
>a : u32
>  : ^^^

// literal into machine type: fits => ok, doesn't fit => flagged
const okLit: u8 = lit
>okLit : u8
>      : ^^
>lit : 200
>    : ^^^

const badLit: u8 = 999
>badLit : u8
>       : ^^
>999 : 999
>    : ^^^

const badLit2: u8 = lit2
>badLit2 : u8
>        : ^^
>lit2 : 200 | 256
>     : ^^^^^^^^^

// any machine type is assignable into plain number
const n: number = a
>n : number
>  : ^^^^^^
>a : u32
>  : ^^^

function checkedFn() {
>checkedFn : () => void
>          : ^^^^^^^^^^

    "use checked"
>"use checked" : "use checked"
>              : ^^^^^^^^^^^^^

    const r: u32 = a + b // stays u32
>r : u32
>  : ^^^
>a + b : u32
>      : ^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^
}

function wrappingFn() {
>wrappingFn : () => void
>           : ^^^^^^^^^^

    "use wrapping"
>"use wrapping" : "use wrapping"
>               : ^^^^^^^^^^^^^^

    const r: u32 = a + b // stays u32
>r : u32
>  : ^^^
>a + b : u32
>      : ^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^
}

function plainFn() {
>plainFn : () => void
>        : ^^^^^^^^^^

    const r = a + b // widens without directive
>r : number
>  : ^^^^^^
>a + b : number
>      : ^^^^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^

    const r2: number = a + b // sanity check for widening
>r2 : number
>   : ^^^^^^
>a + b : number
>      : ^^^^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^
}

function noDirectiveShouldFail() {
>noDirectiveShouldFail : () => void
>                      : ^^^^^^^^^^

    const r: u32 = a + b // error: widened to number, not assignable to u32
>r : u32
>  : ^^^
>a + b : number
>      : ^^^^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^
}

function nested() {
>nested : () => (a: u32, b: u32) => u32
>       : ^^^^^^^ ^^   ^^ ^^   ^^^^^^^^

    "use checked"
>"use checked" : "use checked"
>              : ^^^^^^^^^^^^^

    function add(a: u32, b: u32) {
>add : (a: u32, b: u32) => u32
>    : ^ ^^   ^^ ^^   ^^^^^^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^

        return a + b
>a + b : u32
>      : ^^^
>a : u32
>  : ^^^
>b : u32
>  : ^^^
    }
    return add
>add : (a: u32, b: u32) => u32
>    : ^ ^^   ^^ ^^   ^^^^^^^^
}

function compound() {
>compound : () => u8
>         : ^^^^^^^^

    "use checked"
>"use checked" : "use checked"
>              : ^^^^^^^^^^^^^

    let i: u8 = 0
>i : u8
>  : ^^
>0 : 0
>  : ^

    const z = (i += 1)
>z : u8
>  : ^^
>(i += 1) : u8
>         : ^^
>i += 1 : u8
>       : ^^
>i : u8
>  : ^^
>1 : 1
>  : ^

    return z + 1
>z + 1 : u8
>      : ^^
>z : u8
>  : ^^
>1 : 1
>  : ^
}

function unary() {
>unary : () => u32
>      : ^^^^^^^^^

    "use checked"
>"use checked" : "use checked"
>              : ^^^^^^^^^^^^^

    let r: u32 = 0
>r : u32
>  : ^^^
>0 : 0
>  : ^

    for (let i: u8 = 0; i < 0; i++) {
>i : u8
>  : ^^
>0 : 0
>  : ^
>i < 0 : boolean
>      : ^^^^^^^
>i : u8
>  : ^^
>0 : 0
>  : ^
>i++ : number
>    : ^^^^^^
>i : u8
>  : ^^

        r += i
>r += i : u32
>       : ^^^
>r : u32
>  : ^^^
>i : u8
>  : ^^
    }
    return r
>r : u32
>  : ^^^
}


