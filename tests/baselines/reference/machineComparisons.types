//// [tests/cases/syn/machineComparisons.syn] ////

=== machineComparisons.syn ===
function alwaysFalse(a: u32) {
>alwaysFalse : (a: u32) => boolean
>            : ^ ^^   ^^^^^^^^^^^^
>a : u32
>  : ^^^

    return a < -5
>a < -5 : boolean
>       : ^^^^^^^
>a : u32
>  : ^^^
>-5 : -5
>   : ^^
>5 : 5
>  : ^
}

function alwaysTrue(a: u32) {
>alwaysTrue : (a: u32) => boolean
>           : ^ ^^   ^^^^^^^^^^^^
>a : u32
>  : ^^^

    return a > -5
>a > -5 : boolean
>       : ^^^^^^^
>a : u32
>  : ^^^
>-5 : -5
>   : ^^
>5 : 5
>  : ^
}

function signedCompare(a: i32) {
>signedCompare : (a: i32) => boolean
>              : ^ ^^   ^^^^^^^^^^^^
>a : i32
>  : ^^^

    return a > -5 // boolean
>a > -5 : boolean
>       : ^^^^^^^
>a : i32
>  : ^^^
>-5 : -5
>   : ^^
>5 : 5
>  : ^
}

function alwaysTrue2(a: u8) {
>alwaysTrue2 : (a: u8) => boolean
>            : ^ ^^  ^^^^^^^^^^^^
>a : u8
>  : ^^

    return a >= 0 // true
>a >= 0 : boolean
>       : ^^^^^^^
>a : u8
>  : ^^
>0 : 0
>  : ^
}

function maybeTrue(a: u8) {
>maybeTrue : (a: u8) => boolean
>          : ^ ^^  ^^^^^^^^^^^^
>a : u8
>  : ^^

    return a <= 0 // boolean
>a <= 0 : boolean
>       : ^^^^^^^
>a : u8
>  : ^^
>0 : 0
>  : ^
}

function cmpFloatWithInt(a: f32) {
>cmpFloatWithInt : (a: f32) => a is u32
>                : ^ ^^   ^^^^^^^^^^^^^
>a : f32
>  : ^^^

    return a is u32 // should not error
>a is u32 : boolean
>         : ^^^^^^^
>a : f32
>  : ^^^
}

function cmpSigned(a: i32) {
>cmpSigned : (a: i32) => a is u31
>          : ^ ^^   ^^^^^^^^^^^^^
>a : i32
>  : ^^^

    return a is u32 // should not error
>a is u32 : boolean
>         : ^^^^^^^
>a : i32
>  : ^^^
}

function impossibleIsCheck(a: u32) {
>impossibleIsCheck : (a: u32) => a is -1
>                  : ^ ^^   ^^^^^^^^^^^^
>a : u32
>  : ^^^

    return a is -1
>a is -1 : boolean
>        : ^^^^^^^
>a : u32
>  : ^^^
>-1 : -1
>   : ^^
>1 : 1
>  : ^
}


