                count: {c}
>c : Symbol(c, Decl(staticBindings.syn, 126, 11))

            </div>
>div : Symbol(JSX.IntrinsicElements.div, Decl(lib.jsx.d.ts, --, --))

            <#run>
                if (active) {
>active : Symbol(active, Decl(staticBindings.syn, 124, 11))

                    const id = setInterval(() => {
>id : Symbol(id, Decl(staticBindings.syn, 134, 25))
>setInterval : Symbol(setInterval, Decl(lib.dom.d.ts, --, --))

                        update d {
>d : Symbol(d, Decl(staticBindings.syn, 129, 12))

                            c += 1
>c : Symbol(c, Decl(staticBindings.syn, 126, 11))
                        }
                    }, rate)
>rate : Symbol(rate, Decl(staticBindings.syn, 125, 11))

                    unwind { clearInterval(id) }
>clearInterval : Symbol(clearInterval, Decl(lib.dom.d.ts, --, --))
>id : Symbol(id, Decl(staticBindings.syn, 134, 25))
                }
            </>
        </div>
>div : Symbol(JSX.IntrinsicElements.div, Decl(lib.jsx.d.ts, --, --))

        update counter {
>counter : Symbol(counter, Decl(staticBindings.syn, 128, 13))

            rate = n
>rate : Symbol(rate, Decl(staticBindings.syn, 125, 11))
>n : Symbol(n, Decl(staticBindings.syn, 123, 22))
        }
