>div : Symbol(JSX.IntrinsicElements.div, Decl(lib.jsx.d.ts, --, --))
>counter : Symbol(counter, Decl(staticBindings.syn, 128, 23))

            <div @ d>
>div : Symbol(JSX.IntrinsicElements.div, Decl(lib.jsx.d.ts, --, --))
