// @lib: es5,machine

function alwaysFalse(a: u32) {
    return a < -5
}

function alwaysTrue(a: u32) {
    return a > -5
}

function signedCompare(a: i32) {
    return a > -5 // boolean
}

function alwaysTrue2(a: u8) {
    return a >= 0 // true
}

function maybeTrue(a: u8) {
    return a <= 0 // boolean
}

function cmpFloatWithInt(a: f32) {
    return a is u32 // should not error
}

function cmpSigned(a: i32) {
    return a is u32 // should not error
}

function impossibleIsCheck(a: u32) {
    return a is -1
}
