// @lib: es5,machine

type A = u8 & i8    // u7 (exact value-range intersection)
type B = u8 & u32   // u8
type C = u32 & u8   // u8
type D = u8 & number // u8
type E = number & u8 // u8
type F = u32 & u64  // u32
type G = i32 & i32  // i32
type H = u16 & i8   // u7 ([0,65535] & [-128,127] = [0,127])
type I = f32 & u32  // u32 (float never restricts an integral type further)
type J = f32 & f64  // f32
type K = i8 & f32   // i8
type L = i8 & 255   // never (255 is out of i8's range)
type M = i8 & 1     // 1 (literal is in range, and more specific)
type N = 1 & i8     // 1 (order shouldn't matter)
type O = u8 & 1     // 1
type P = u8 & (1 | -1)     // 1
const p: P = -1

declare const a: A
declare const b: B
declare const c: C
declare const d: D
declare const e: E
declare const f: F
declare const g: G
declare const h: H
declare const i: I
declare const j: J
declare const k: K
